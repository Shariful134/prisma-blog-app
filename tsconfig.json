{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "module": "NodeNext",
    "target": "ES2023",
    "moduleResolution": "NodeNext",
    "types": [
      "node"
    ],
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "prisma7.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "generated"
  ]
}